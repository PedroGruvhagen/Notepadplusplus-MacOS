<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  CFBundleDocumentTypes: declare that Notepad++ can open ANY file, matching the
	  Windows app which opens all files regardless of extension. This lets Finder
	  offer "Open With > Notepad++" and route double-clicks / drag-and-drop for
	  arbitrary files (zip, binary, extensionless) into application(_:open:), which
	  calls the unrestricted openDocument(from:) path.

	  LSHandlerRank = Alternate ensures we are NEVER the default handler, so we do
	  not hijack .zip from Archive Utility or any other type's system owner; we only
	  appear as an option. LSItemContentTypes public.data covers every file and
	  public.item covers any filesystem item.

	  GENERATE_INFOPLIST_FILE remains YES; Xcode merges the INFOPLIST_KEY_* build
	  settings into this file at build time, so only CFBundleDocumentTypes is declared here.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>All Files</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
				<string>public.item</string>
			</array>
		</dict>
	</array>
	<!--
	  Sparkle 2 auto-update (UpdaterManager.swift). These have no INFOPLIST_KEY_* build-setting
	  equivalent, so they are declared directly here and merged in by GENERATE_INFOPLIST_FILE, same
	  as CFBundleDocumentTypes above.

	  SUFeedURL: the appcast this build checks against. Published at the repo root (appcast.xml) and
	  populated by scripts/sign-and-notarize.sh on every release.
	  SUPublicEDKey: the EdDSA public key generated once via Sparkle's generate_keys tool (private key
	  stays in the login Keychain; sign_update uses it to sign each release DMG). Still the
	  REPLACE_ME sentinel: generate_keys needs an interactive Keychain authorization dialog that
	  cannot be approved in a non-interactive session. See
	  .deferred/notepadpp/2026-08-13-sparkle-eddsa-keys.md and lore/pages/auto-update-sparkle.md.
	  SUEnableAutomaticChecks: Sparkle's own opt-in flag for background checks; UpdaterManager also
	  drives automaticallyChecksForUpdates directly from AppSettings.checkForUpdates at every launch,
	  so this is the same default the Settings toggle starts with.
	-->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/PedroGruvhagen/Notepadplusplus-MacOS/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>REPLACE_ME</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
